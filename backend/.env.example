# ═══════════════════════════════════════════
# AgroNexus Backend — Environment Variables
# ═══════════════════════════════════════════

# Server
NODE_ENV=development
PORT=5000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/agronexus?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRE=7d

# Frontend URL(s) for CORS — comma-separated for multiple origins
# Example: http://localhost:3000,https://agronexus.vercel.app
CLIENT_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Weather API
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# EmailJS (for cloud alert emails)
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Twilio SMS (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
